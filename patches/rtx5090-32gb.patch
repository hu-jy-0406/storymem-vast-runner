--- a/wan/distributed/fsdp.py
+++ b/wan/distributed/fsdp.py
@@ -1,6 +1,7 @@
 # Copyright 2024-2025 The Alibaba Wan Team Authors. All rights reserved.
 import gc
 from functools import partial
+from contextlib import contextmanager
 
 import torch
 from torch.distributed.fsdp import FullyShardedDataParallel as FSDP
@@ -41,3 +42,38 @@ def free_model(model):
     del model
     gc.collect()
     torch.cuda.empty_cache()
+
+
+@contextmanager
+def offload_idle_fsdp_shards(*models):
+    """Temporarily move idle FSDP shard references while an auxiliary model runs.
+
+    Module.cpu() moves flat_param.data, but FSDP keeps its own _local_shard
+    reference. Restore its exact dtype/content/device before the next forward.
+    Only already-offloaded, inference-only modules may enter this context.
+    """
+    moved = []
+    seen = set()
+    try:
+        for model in models:
+            for module in model.modules():
+                if not isinstance(module, FSDP) or module._handle is None:
+                    continue
+                flat = module._handle.flat_param
+                if id(flat) in seen:
+                    continue
+                seen.add(id(flat))
+                shard = getattr(flat, "_local_shard", None)
+                if shard is not None and shard.is_cuda and not flat.is_cuda:
+                    assert not flat.requires_grad, "Only inference shards may be offloaded"
+                    device = shard.device
+                    flat._local_shard = shard.cpu()
+                    moved.append((flat, device))
+                del shard
+        torch.cuda.empty_cache()
+        yield
+    finally:
+        gc.collect()
+        torch.cuda.empty_cache()
+        for flat, device in moved:
+            flat._local_shard = flat._local_shard.to(device)
