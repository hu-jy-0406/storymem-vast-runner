# Copy this file to a job directory as config.env, then set these values.
export STORYMEM_REPO=/workspace/StoryMem
export STORYMEM_RUN_ROOT=/workspace/storymem-jobs/other-batch
export STORYMEM_BUNDLE=/workspace/datasets/eec-bench-storymem-400/batches/storymem_inputs_0150_0200
export HF_HOME=/workspace/.hf_home

# Required on this 8 x RTX 5090 / 32 GB configuration.
export LD_PRELOAD=/workspace/storymem-runtime/nccl/lib/libnccl.so.2
export NCCL_CUMEM_HOST_ENABLE=0
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export CUBLAS_WORKSPACE_CONFIG=:16:8
export CUDA_CACHE_MAXSIZE=4294967296
export OMP_NUM_THREADS=4
export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
